<!DOCTYPE html>
<!-- saved from url=(0045)file:///C:/Users/klopp/Downloads/index_4.html -->
<html lang="fr"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TradeTracker Pro</title>
<link href="./TradeTracker Pro_files/css2" rel="stylesheet">
<link rel="stylesheet" href="./TradeTracker Pro_files/all.min.css">
<script src="./TradeTracker Pro_files/chart.umd.min.js.télécharger"></script>

<!-- Firebase SDK -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged }
    from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc, addDoc, updateDoc, deleteDoc,
           collection, query, where, getDocs, orderBy, serverTimestamp, writeBatch }
    from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

  // ══════════════════════════════════════════════
  //  🔥 FIREBASE CONFIG — remplace par ta config
  //     Firebase Console > Paramètres > SDK
  // ══════════════════════════════════════════════
  const firebaseConfig = {
    apiKey:            "AIzaSyANuBhz9vpV88U6n3MKR1rhVVFXi0l8ySw",
    authDomain:        "tradetracker-pro-64941.firebaseapp.com",
    projectId:         "tradetracker-pro-64941",
    storageBucket:     "tradetracker-pro-64941.firebasestorage.app",
    messagingSenderId: "993339889025",
    appId:             "1:993339889025:web:b4b63757ac211420e60480"
  };

  const app  = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db   = getFirestore(app);

  // ══════════════════════════════════════════════
  //  DATABASE LAYER — toutes les données sont
  //  isolées par userId dans Firestore
  //
  //  Structure :
  //  users/{userId}                    → profil
  //  users/{userId}/accounts/{acctId}  → comptes
  //  users/{userId}/trades/{tradeId}   → trades
  //  users/{userId}/objectives/{objId} → objectifs
  // ══════════════════════════════════════════════

  const DB = {
    uid: null,

    userRef()    { return doc(db, 'users', this.uid); },
    accountsRef(){ return collection(db, 'users', this.uid, 'accounts'); },
    tradesRef()  { return collection(db, 'users', this.uid, 'trades'); },
    objRef()     { return collection(db, 'users', this.uid, 'objectives'); },

    // ─── USER PROFILE ───
    async getUser() {
      const snap = await getDoc(this.userRef());
      return snap.exists() ? snap.data() : null;
    },

    async createUser(googleUser) {
      const profile = {
        uid:         googleUser.uid,
        email:       googleUser.email,
        displayName: googleUser.displayName,
        photoURL:    googleUser.photoURL,
        createdAt:   serverTimestamp(),
        activeAccountId: null,
      };
      await setDoc(this.userRef(), profile);
      return profile;
    },

    async updateUser(data) {
      await updateDoc(this.userRef(), data);
    },

    // ─── ACCOUNTS ───
    async getAccounts() {
      const snap = await getDocs(this.accountsRef());
      return snap.docs.map(d => ({ id: d.id, ...d.data() }));
    },

    async createAccount(data) {
      const ref = await addDoc(this.accountsRef(), {
        ...data,
        userId:    this.uid,
        createdAt: serverTimestamp(),
      });
      return { id: ref.id, ...data };
    },

    async updateAccount(id, data) {
      await updateDoc(doc(db, 'users', this.uid, 'accounts', id), data);
    },

    async deleteAccount(id) {
      // Delete all trades for this account
      const tSnap = await getDocs(query(this.tradesRef(), where('accountId', '==', id)));
      const oSnap = await getDocs(query(this.objRef(), where('accountId', '==', id)));
      const batch = writeBatch(db);
      tSnap.docs.forEach(d => batch.delete(d.ref));
      oSnap.docs.forEach(d => batch.delete(d.ref));
      batch.delete(doc(db, 'users', this.uid, 'accounts', id));
      await batch.commit();
    },

    // ─── TRADES ───
    async getTrades(accountId) {
      const q = query(this.tradesRef(), where('accountId', '==', accountId));
      const snap = await getDocs(q);
      return snap.docs.map(d => ({ id: d.id, ...d.data() }));
    },

    async addTrade(data) {
      const ref = await addDoc(this.tradesRef(), {
        ...data,
        userId:    this.uid,
        createdAt: serverTimestamp(),
      });
      return { id: ref.id, ...data };
    },

    async deleteTrade(id) {
      await deleteDoc(doc(db, 'users', this.uid, 'trades', id));
    },

    // ─── OBJECTIVES ───
    async getObjectives(accountId) {
      const q = query(this.objRef(), where('accountId', '==', accountId));
      const snap = await getDocs(q);
      return snap.docs.map(d => ({ id: d.id, ...d.data() }));
    },

    async addObjective(data) {
      const ref = await addDoc(this.objRef(), {
        ...data,
        userId:    this.uid,
        createdAt: serverTimestamp(),
      });
      return { id: ref.id, ...data };
    },

    async deleteObjective(id) {
      await deleteDoc(doc(db, 'users', this.uid, 'objectives', id));
    },
  };

  // ══════════════════════════════════════════════
  //  AUTH STATE — central entry point
  // ══════════════════════════════════════════════
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      DB.uid = user.uid;
      showLoader('Chargement de votre espace...');
      await initUserSession(user);
      hideLoader();
      showApp();
    } else {
      showLoginScreen();
    }
  });

  // ─── GOOGLE SIGN IN ───
  window.signInWithGoogle = async () => {
    try {
      setLoginLoading(true);
      const provider = new GoogleAuthProvider();
      provider.setCustomParameters({ prompt: 'select_account' });
      await signInWithPopup(auth, provider);
    } catch (e) {
      setLoginLoading(false);
      showLoginError(e.code === 'auth/popup-closed-by-user'
        ? 'Connexion annulée.'
        : 'Erreur de connexion. Réessayez.');
    }
  };

  // ─── SIGN OUT ───
  window.doSignOut = async () => {
    if (!confirm('Se déconnecter ?')) return;
    await signOut(auth);
  };

  // ══════════════════════════════════════════════
  //  SESSION INIT
  // ══════════════════════════════════════════════
  async function initUserSession(googleUser) {
    try {
      // Get or create user profile
      let profile = await DB.getUser();
      if (!profile) {
        profile = await DB.createUser(googleUser);
        await createDefaultAccount();
      }

      // Load accounts
      AppState.accounts = await DB.getAccounts();

      // If no accounts exist (edge case), create default
      if (AppState.accounts.length === 0) {
        await createDefaultAccount();
        AppState.accounts = await DB.getAccounts();
      }

      // Determine active account
      const savedId = profile.activeAccountId || AppState.accounts[0]?.id;
      if (savedId && AppState.accounts.find(a => a.id === savedId)) {
        AppState.activeAccountId = savedId;
      } else if (AppState.accounts.length > 0) {
        AppState.activeAccountId = AppState.accounts[0].id;
      }

      // Load data for active account
      if (AppState.activeAccountId) {
        await loadAccountData(AppState.activeAccountId);
      }

      // Update UI with user info
      updateUserUI(googleUser);
    } catch(err) {
      console.error('Session init error:', err);
      hideLoader();
      showLoginError('Erreur de chargement: ' + err.message);
      showLoginScreen();
    }
  }

  async function createDefaultAccount() {
    const acct = await DB.createAccount({
      name:    'Compte Principal',
      type:    'Live',
      broker:  '',
      capital: 10000,
      goal:    1000,
      color:   '#3b7fff',
    });
    AppState.accounts = [acct];
    AppState.activeAccountId = acct.id;
    await DB.updateUser({ activeAccountId: acct.id });
    // Seed demo trades for first-time users
    await seedDemoTrades(acct.id);
  }

  async function seedDemoTrades(accountId) {
    const demos = [
      {instrument:'EUR/USD',market:'Forex',direction:'BUY',entry:1.0850,exit:1.0920,sl:1.0810,tp:1.0950,lots:0.50,pnl:350,status:'Gagné',date:'2025-01-15',setup:'Breakout',notes:'Exemple de trade'},
      {instrument:'GBP/JPY',market:'Forex',direction:'SELL',entry:187.50,exit:185.80,sl:188.50,tp:184.00,lots:0.30,pnl:510,status:'Gagné',date:'2025-02-01',setup:'Résistance',notes:''},
      {instrument:'BTC/USD',market:'Crypto',direction:'BUY',entry:42000,exit:44500,sl:40000,tp:46000,lots:0.05,pnl:125,status:'Gagné',date:'2025-02-10',setup:'Support',notes:''},
      {instrument:'AAPL',market:'Actions',direction:'BUY',entry:185,exit:179,sl:182,tp:195,lots:10,pnl:-60,status:'Perdu',date:'2025-02-20',setup:'Retracement',notes:'Faux signal'},
      {instrument:'GOLD',market:'Matière première',direction:'BUY',entry:2020,exit:null,sl:2000,tp:2080,lots:0.10,pnl:null,status:'Ouvert',date:'2025-03-01',setup:'Tendance',notes:'En cours'},
    ];
    for (const t of demos) {
      await DB.addTrade({ ...t, accountId });
    }
    AppState.trades = await DB.getTrades(accountId);
  }

  async function loadAccountData(accountId) {
    AppState.trades     = await DB.getTrades(accountId) || [];
    AppState.objectives = await DB.getObjectives(accountId) || [];
    // Sort trades by date desc (client-side since we removed orderBy)
    AppState.trades.sort((a,b) => b.date > a.date ? 1 : -1);
  }

  // ══════════════════════════════════════════════
  //  APP STATE
  // ══════════════════════════════════════════════
  const AppState = {
    accounts: [],
    activeAccountId: null,
    trades: [],
    objectives: [],
    chartInst: {},
    editingAcctId: null,
    selectedColor: '#3b7fff',
  };

  const COLORS = ['#3b7fff','#22c55e','#ef4444','#f59e0b','#8b5cf6','#ec4899','#06b6d4','#f97316','#84cc16','#64748b'];

  // ══════════════════════════════════════════════
  //  ACCOUNT ACTIONS
  // ══════════════════════════════════════════════
  window.switchAccount = async (id) => {
    showLoader('Chargement du compte...');
    AppState.activeAccountId = id;
    await DB.updateUser({ activeAccountId: id });
    await loadAccountData(id);
    hideLoader();
    closeDropdown();
    renderAll();
    const acct = getAcct();
    showToast(`✓ Compte actif : ${acct.name}`, acct.color);
  };

  window.saveAccount = async () => {
    const name = document.getElementById('acctName').value.trim();
    if (!name) { alert('Nom requis !'); return; }
    const data = {
      name,
      type:    document.getElementById('acctType').value,
      broker:  document.getElementById('acctBroker').value,
      capital: parseFloat(document.getElementById('acctCapital').value) || 0,
      goal:    parseFloat(document.getElementById('acctGoal').value) || 0,
      color:   AppState.selectedColor,
    };
    showLoader('Enregistrement...');
    if (AppState.editingAcctId) {
      await DB.updateAccount(AppState.editingAcctId, data);
      AppState.accounts = AppState.accounts.map(a =>
        a.id === AppState.editingAcctId ? { ...a, ...data } : a
      );
      showToast('✓ Compte mis à jour');
    } else {
      const newAcct = await DB.createAccount(data);
      AppState.accounts.push(newAcct);
      showToast('✓ Compte créé : ' + name, data.color);
    }
    hideLoader();
    closeNewAcctModal();
    renderAll();
    if (!AppState.editingAcctId) await switchAccount(AppState.accounts.slice(-1)[0].id);
  };

  window.deleteAccount = async (id) => {
    if (AppState.accounts.length <= 1) { alert('Gardez au moins un compte.'); return; }
    const a = getAcct(id);
    if (!confirm(`Supprimer "${a.name}" et TOUS ses trades ? Action irréversible.`)) return;
    showLoader('Suppression...');
    await DB.deleteAccount(id);
    AppState.accounts = AppState.accounts.filter(a => a.id !== id);
    if (AppState.activeAccountId === id) {
      AppState.activeAccountId = AppState.accounts[0].id;
      await loadAccountData(AppState.activeAccountId);
    }
    hideLoader();
    renderAll();
    showToast('✓ Compte supprimé');
  };

  // ══════════════════════════════════════════════
  //  TRADE ACTIONS
  // ══════════════════════════════════════════════
  window.saveTrade = async () => {
    const instr = document.getElementById('tInstr').value.trim();
    const entry = parseFloat(document.getElementById('tEntry').value);
    if (!instr || !entry) { alert('Instrument et entrée requis !'); return; }
    const trade = {
      accountId:   AppState.activeAccountId,
      instrument:  instr.toUpperCase(),
      market:      document.getElementById('tMkt').value,
      direction:   document.getElementById('tDir').value,
      entry,
      exit:   parseFloat(document.getElementById('tExit').value) || null,
      sl:     parseFloat(document.getElementById('tSL').value) || null,
      tp:     parseFloat(document.getElementById('tTP').value) || null,
      lots:   parseFloat(document.getElementById('tLots').value) || 0.01,
      pnl:    parseFloat(document.getElementById('tPnl').value) || null,
      status: document.getElementById('tStat').value,
      date:   document.getElementById('tDate').value,
      setup:  document.getElementById('tSetup').value,
      notes:  document.getElementById('tNotes').value,
    };
    showLoader('Enregistrement...');
    const saved = await DB.addTrade(trade);
    AppState.trades.unshift(saved);
    hideLoader();
    closeModal();
    renderDashboard();
    renderJournal();
    showToast('✓ Trade enregistré');
    ['tInstr','tEntry','tExit','tSL','tTP','tPnl','tSetup','tNotes'].forEach(id => document.getElementById(id).value = '');
  };

  window.delTrade = async (id) => {
    if (!confirm('Supprimer ce trade ?')) return;
    showLoader('Suppression...');
    await DB.deleteTrade(id);
    AppState.trades = AppState.trades.filter(t => t.id !== id);
    hideLoader();
    renderJournal();
    renderDashboard();
    showToast('Trade supprimé');
  };

  // ══════════════════════════════════════════════
  //  OBJECTIVE ACTIONS
  // ══════════════════════════════════════════════
  window.saveObj = async () => {
    const title  = document.getElementById('oTitle').value.trim();
    const target = parseFloat(document.getElementById('oTarget').value);
    if (!title || !target) { alert('Titre et cible requis !'); return; }
    const obj = {
      accountId: AppState.activeAccountId,
      title,
      type:     document.getElementById('oType').value,
      target,
      current:  parseFloat(document.getElementById('oCurrent').value) || 0,
      deadline: document.getElementById('oDeadline').value,
      desc:     document.getElementById('oDesc').value,
    };
    showLoader('Enregistrement...');
    const saved = await DB.addObjective(obj);
    AppState.objectives.push(saved);
    hideLoader();
    closeObjModal();
    renderObjectives();
    ['oTitle','oTarget','oCurrent','oDesc'].forEach(id => document.getElementById(id).value = '');
  };

  window.delObj = async (id) => {
    showLoader('Suppression...');
    await DB.deleteObjective(id);
    AppState.objectives = AppState.objectives.filter(o => o.id !== id);
    hideLoader();
    renderObjectives();
  };

  // ══════════════════════════════════════════════
  //  HELPERS
  // ══════════════════════════════════════════════
  function getAcct(id) {
    return AppState.accounts.find(a => a.id === (id || AppState.activeAccountId));
  }

  function computeStats(trades) {
    const cl = trades.filter(t => t.status !== 'Ouvert' && t.pnl != null);
    const wins = cl.filter(t => t.pnl > 0);
    const losses = cl.filter(t => t.pnl < 0);
    const pnl = cl.reduce((a,t) => a+t.pnl, 0);
    const wr = cl.length ? wins.length/cl.length*100 : 0;
    const avgW = wins.length ? wins.reduce((a,t)=>a+t.pnl,0)/wins.length : 0;
    const avgL = losses.length ? Math.abs(losses.reduce((a,t)=>a+t.pnl,0)/losses.length) : 0;
    const pf = (avgL > 0 && losses.length) ? (avgW*wins.length)/(avgL*losses.length) : 0;
    const esp = cl.length ? (wr/100)*avgW - (1-wr/100)*avgL : 0;
    const open = trades.filter(t => t.status === 'Ouvert');
    let peak=0,dd=0,maxDD=0,cum=0;
    cl.forEach(t=>{cum+=t.pnl;if(cum>peak)peak=cum;dd=peak>0?(peak-cum)/peak*100:0;if(dd>maxDD)maxDD=dd;});
    return { pnl, wr, wins:wins.length, losses:losses.length, total:trades.length, open:open.length, avgW, avgL, pf, esp, maxDD };
  }

  function fmt(v,sign=false,prefix=''){const abs=Math.abs(v).toFixed(2);return sign?(v>=0?'+':'-')+prefix+abs:prefix+abs;}

  // ══════════════════════════════════════════════
  //  UI RENDERERS
  // ══════════════════════════════════════════════
  function renderAll() {
    updateNavAccountBtn();
    renderDashboard();
    renderDropdownList();
    renderAccountsPage();
  }

  function updateUserUI(user) {
    const name = user.displayName?.split(' ')[0] || 'Utilisateur';
    document.getElementById('userDisplayName').textContent = name;
    if (user.photoURL) {
      document.getElementById('userAvatar').innerHTML = `<img src="${user.photoURL}" style="width:28px;height:28px;border-radius:50%;object-fit:cover">`;
    } else {
      document.getElementById('userAvatar').innerHTML = name.charAt(0).toUpperCase();
    }
  }

  function updateNavAccountBtn() {
    const acct = getAcct();
    if (!acct) return;
    document.getElementById('acctBtnDot').style.background = acct.color;
    document.getElementById('acctBtnName').textContent = acct.name;
    document.getElementById('acctBtnType').textContent = acct.type;
    document.getElementById('tradeModalAcct').textContent = acct.name;
    document.querySelectorAll('[id$="AcctBadge"]').forEach(el => el.textContent = '— ' + acct.name);
  }

  // ─── DROPDOWN ───
  function renderDropdownList() {
    document.getElementById('acctDropList').innerHTML = AppState.accounts.map(a => {
      const trades = AppState.activeAccountId === a.id ? AppState.trades :
        []; // Only show P&L for active account in dropdown
      const pnl = AppState.activeAccountId === a.id
        ? AppState.trades.filter(t=>t.pnl!=null).reduce((s,t)=>s+t.pnl,0)
        : 0;
      const isActive = a.id === AppState.activeAccountId;
      return `<div class="acct-item ${isActive?'selected':''}" onclick="switchAccount('${a.id}')">
        <div class="acct-item-dot" style="background:${a.color}"></div>
        <div class="acct-item-info">
          <div class="acct-item-name">${a.name}</div>
          <div class="acct-item-meta">${a.type}${a.broker?' · '+a.broker:''}</div>
        </div>
        ${isActive?`<div class="acct-item-pnl" style="color:${pnl>=0?'var(--green)':'var(--red)'}">${pnl>=0?'+':''}$${pnl.toFixed(0)}</div>`:''}
        <div class="acct-item-actions" onclick="event.stopPropagation()">
          <button class="acct-icon-btn" onclick="openEditAcctModal('${a.id}')"><i class="fa-solid fa-pen"></i></button>
          <button class="acct-icon-btn danger" onclick="deleteAccount('${a.id}')"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>`;
    }).join('');
  }

  // ─── DASHBOARD ───
  function renderDashboard() {
    const acct = getAcct();
    if (!acct) return;
    const s = computeStats(AppState.trades);
    const closed = AppState.trades.filter(t => t.status !== 'Ouvert');

    document.getElementById('acctBanner').innerHTML = `
      <div class="acct-banner-dot" style="background:${acct.color}"></div>
      <div class="acct-banner-info">
        <div class="acct-banner-name">${acct.name}</div>
        <div class="acct-banner-meta">
          <span><i class="fa-solid fa-building"></i> ${acct.broker||'—'}</span>
          <span><i class="fa-solid fa-tag"></i> ${acct.type}</span>
          <span><i class="fa-solid fa-wallet"></i> Capital: $${(acct.capital||0).toLocaleString()}</span>
          <span><i class="fa-solid fa-bullseye" style="color:var(--gold)"></i> Objectif: $${(acct.goal||0).toLocaleString()}</span>
        </div>
      </div>
      <div><button class="btn btn-ghost btn-sm" onclick="openEditAcctModal('${acct.id}')"><i class="fa-solid fa-pen"></i> Modifier</button></div>`;

    document.getElementById('dashAcctBadge').textContent = '— ' + acct.name;
    document.getElementById('dashSub').textContent = closed.length + ' trades fermés';

    const cards = [
      {label:'P&L TOTAL',icon:'$',val:fmt(s.pnl,true,'$'),cls:s.pnl>=0?'val-green':'val-red',sub:`${closed.length} trades fermés`},
      {label:'WIN RATE',icon:'%',val:s.wr.toFixed(1)+'%',cls:'val-blue',sub:`${s.wins}W / ${s.losses}L`},
      {label:'PROFIT FACTOR',icon:'↗',val:s.pf.toFixed(2),cls:'val-white',sub:'Gains / Pertes'},
      {label:'ESPÉRANCE',icon:'◎',val:fmt(s.esp,true,'$'),cls:s.esp>=0?'val-green':'val-red',sub:'Par trade moyen'},
      {label:'GAIN MOYEN',icon:'↑',val:fmt(s.avgW,false,'$'),cls:'val-green',sub:`${s.wins} gagnants`},
      {label:'PERTE MOYENNE',icon:'↓',val:'-$'+s.avgL.toFixed(2),cls:'val-red',sub:`${s.losses} perdants`},
      {label:'MAX DRAWDOWN',icon:'⚡',val:'-'+s.maxDD.toFixed(2)+'$',cls:'val-red',sub:'Pire série'},
    ];
    document.getElementById('statsGrid').innerHTML = cards.map(c=>`
      <div class="stat-card">
        <div class="stat-card-label">${c.label} <span>${c.icon}</span></div>
        <div class="stat-card-value ${c.cls}">${c.val}</div>
        <div class="stat-card-sub">${c.sub}</div>
      </div>`).join('') + `
      <div class="stat-card" style="grid-column:span 1;margin-top:8px;grid-row:2">
        <div class="stat-card-label">TRADES OUVERTS</div>
        <div class="stat-card-value val-blue">${s.open}</div>
        <div class="stat-card-sub">Positions actives</div>
      </div>`;

    renderEquityChart();
    renderMonthlyDash();
    renderRecentTrades();
  }

  function renderEquityChart() {
    const cl = [...AppState.trades].filter(t=>t.pnl!=null).sort((a,b)=>a.date>b.date?1:-1);
    document.getElementById('equityEmpty').style.display = cl.length?'none':'block';
    if (!cl.length) return;
    let cum=0; const labels=[], data=[];
    cl.forEach(t=>{cum+=t.pnl;labels.push(t.date.slice(5));data.push(+cum.toFixed(2));});
    if (AppState.chartInst.equity) AppState.chartInst.equity.destroy();
    const pos = cum>=0;
    AppState.chartInst.equity = new Chart(document.getElementById('equityChart').getContext('2d'),{
      type:'line',data:{labels,datasets:[{data,borderColor:pos?'#22c55e':'#ef4444',backgroundColor:pos?'rgba(34,197,94,.07)':'rgba(239,68,68,.07)',borderWidth:2,fill:true,tension:.4,pointRadius:0,pointHoverRadius:4}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false,backgroundColor:'#1e2128',borderColor:'#2a2d36',borderWidth:1,titleColor:'#9ca3b0',bodyColor:'#f1f3f7',callbacks:{label:ctx=>' $'+ctx.raw}}},scales:{x:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10,family:'DM Mono'}}},y:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10,family:'DM Mono'},callback:v=>'$'+v}}}}
    });
  }

  function renderMonthlyDash() {
    const months={};
    AppState.trades.filter(t=>t.pnl!=null).forEach(t=>{const m=t.date.slice(0,7);months[m]=(months[m]||0)+t.pnl;});
    const labels=Object.keys(months).sort();
    document.getElementById('monthlyEmpty').style.display = labels.length?'none':'block';
    if (!labels.length) return;
    const data=labels.map(m=>months[m]);
    if (AppState.chartInst.mDash) AppState.chartInst.mDash.destroy();
    AppState.chartInst.mDash = new Chart(document.getElementById('monthlyChartDash').getContext('2d'),{
      type:'bar',data:{labels:labels.map(l=>l.slice(5)),datasets:[{data,backgroundColor:data.map(v=>v>=0?'rgba(34,197,94,.4)':'rgba(239,68,68,.4)'),borderColor:data.map(v=>v>=0?'#22c55e':'#ef4444'),borderWidth:1.5,borderRadius:4}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10}}},y:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10},callback:v=>'$'+v}}}}
    });
  }

  function renderRecentTrades() {
    const recent = AppState.trades.slice(0, 8);
    document.getElementById('recentBody').innerHTML = recent.length
      ? recent.map(t=>trRow(t,false)).join('')
      : `<tr><td colspan="8" style="text-align:center;color:var(--text-dim);padding:24px">Aucun trade. Cliquez sur "Nouveau trade".</td></tr>`;
  }

  // ─── JOURNAL ───
  window.renderJournal = () => {
    const acct = getAcct();
    if (acct) {
      document.getElementById('journalAcctBadge').textContent = '— ' + acct.name;
      document.getElementById('journalSub').textContent = AppState.trades.length + ' trades';
    }
    const fm = document.getElementById('filterMarket').value;
    const fd = document.getElementById('filterDir').value;
    const fs = document.getElementById('filterStatus').value;
    let f = [...AppState.trades];
    if (fm) f = f.filter(t=>t.market===fm);
    if (fd) f = f.filter(t=>t.direction===fd);
    if (fs) f = f.filter(t=>t.status===fs);
    document.getElementById('journalBody').innerHTML = f.length
      ? f.map(t=>trRow(t,true)).join('')
      : `<tr><td colspan="15" style="text-align:center;color:var(--text-dim);padding:24px">Aucun trade</td></tr>`;
  };

  function trRow(t, full=false) {
    const mkt={Forex:'forex',Crypto:'crypto',Actions:'stock','Matière première':'commodity'}[t.market]||'forex';
    const sts={Ouvert:`<span class="status s-open">● Ouvert</span>`,Gagné:`<span class="status s-win">✓ Gagné</span>`,Perdu:`<span class="status s-loss">✗ Perdu</span>`}[t.status]||'';
    const pnlH=t.pnl!=null?`<span class="${t.pnl>=0?'pnl-p':'pnl-n'}">${t.pnl>=0?'+':''}$${t.pnl}</span>`:'<span style="color:var(--text-dim)">—</span>';
    if (!full) return `<tr><td><span class="symbol">${t.instrument}</span></td><td><span class="tag tag-${t.direction==='BUY'?'buy':'sell'}">${t.direction}</span></td><td><span class="tag tag-${mkt}">${t.market}</span></td><td class="mono">${t.entry}</td><td class="mono">${t.exit||'—'}</td><td>${pnlH}</td><td>${sts}</td><td class="mono" style="font-size:11px;color:var(--text-dim)">${t.date}</td></tr>`;
    const rr=(t.sl&&t.tp&&t.entry)?'1:'+(Math.abs(t.tp-t.entry)/Math.abs(t.entry-t.sl)).toFixed(1):'—';
    return `<tr><td class="mono" style="color:var(--text-dim);font-size:11px">#${t.id?.slice(-4)||''}</td><td><span class="symbol">${t.instrument}</span></td><td><span class="tag tag-${mkt}">${t.market}</span></td><td><span class="tag tag-${t.direction==='BUY'?'buy':'sell'}">${t.direction}</span></td><td class="mono">${t.entry}</td><td class="mono">${t.exit||'—'}</td><td class="mono" style="color:var(--text-dim)">${t.sl||'—'}</td><td class="mono" style="color:var(--text-dim)">${t.tp||'—'}</td><td class="mono">${t.lots}</td><td>${pnlH}</td><td class="mono" style="color:var(--text-dim)">${rr}</td><td>${sts}</td><td style="font-size:11px;color:var(--text-dim)">${t.setup||'—'}</td><td class="mono" style="font-size:11px;color:var(--text-dim)">${t.date}</td><td><button onclick="delTrade('${t.id}')" style="background:var(--red-dim);border:1px solid rgba(239,68,68,.3);color:var(--red);border-radius:5px;padding:2px 8px;cursor:pointer;font-size:11px">✕</button></td></tr>`;
  }

  // ─── ANALYTICS ───
  window.renderAnalytics = () => {
    const acct = getAcct();
    if (acct) document.getElementById('analyticsAcctBadge').textContent = '— ' + acct.name;
    ['monthlyChart','winLossChart','pnlMarketChart','weeklyChart'].forEach(id=>{if(AppState.chartInst[id])AppState.chartInst[id].destroy();});
    const s = computeStats(AppState.trades);
    const months={};
    AppState.trades.filter(t=>t.pnl!=null).forEach(t=>{const m=t.date.slice(0,7);months[m]=(months[m]||0)+t.pnl;});
    const ml=Object.keys(months).sort(),md=ml.map(m=>months[m]);
    AppState.chartInst.monthlyChart=new Chart(document.getElementById('monthlyChart').getContext('2d'),{type:'bar',data:{labels:ml.map(l=>l.slice(5)),datasets:[{data:md,backgroundColor:md.map(v=>v>=0?'rgba(34,197,94,.4)':'rgba(239,68,68,.4)'),borderColor:md.map(v=>v>=0?'#22c55e':'#ef4444'),borderWidth:1.5,borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10}}},y:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10},callback:v=>'$'+v}}}}});
    AppState.chartInst.winLossChart=new Chart(document.getElementById('winLossChart').getContext('2d'),{type:'doughnut',data:{labels:['Gains','Pertes'],datasets:[{data:[s.wins,s.losses],backgroundColor:['rgba(34,197,94,.4)','rgba(239,68,68,.4)'],borderColor:['#22c55e','#ef4444'],borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#9ca3b0',font:{size:11},padding:10,boxWidth:12}}}}});
    const mkts=['Forex','Crypto','Actions','Matière première'],mColors=['#3b7fff','#8b5cf6','#f59e0b','#22c55e'];
    const mkPnl=mkts.map(m=>AppState.trades.filter(t=>t.market===m&&t.pnl!=null).reduce((a,t)=>a+t.pnl,0));
    AppState.chartInst.pnlMarketChart=new Chart(document.getElementById('pnlMarketChart').getContext('2d'),{type:'bar',data:{labels:mkts,datasets:[{data:mkPnl,backgroundColor:mColors.map(c=>c+'44'),borderColor:mColors,borderWidth:1.5,borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10}}},y:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10},callback:v=>'$'+v}}}}});
    const days=['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'],wd=days.map((_,i)=>AppState.trades.filter(t=>t.pnl!=null&&new Date(t.date).getDay()===(i+1)%7).reduce((a,t)=>a+t.pnl,0));
    AppState.chartInst.weeklyChart=new Chart(document.getElementById('weeklyChart').getContext('2d'),{type:'bar',data:{labels:days,datasets:[{data:wd,backgroundColor:wd.map(v=>v>=0?'rgba(34,197,94,.3)':'rgba(239,68,68,.3)'),borderColor:wd.map(v=>v>=0?'#22c55e':'#ef4444'),borderWidth:1.5,borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10}}},y:{grid:{color:'rgba(42,45,54,.5)'},ticks:{color:'#4b5263',font:{size:10},callback:v=>'$'+v}}}}});
    const exp=(s.wr/100*s.avgW-(1-s.wr/100)*s.avgL).toFixed(0);
    document.getElementById('keyStats').innerHTML=[['Gain Moyen',`<span style="color:var(--green)">+$${s.avgW.toFixed(0)}</span>`],['Perte Moy.',`<span style="color:var(--red)">-$${s.avgL.toFixed(0)}</span>`],['Espérance',`<span style="color:${exp>=0?'var(--green)':'var(--red)'}">$${exp}</span>`],['Profit Factor',`<span style="color:var(--blue)">${s.pf.toFixed(2)}</span>`],['Meilleur',`<span style="color:var(--green)">+$${Math.max(...AppState.trades.filter(t=>t.pnl!=null).map(t=>t.pnl),0)}</span>`],['Pire',`<span style="color:var(--red)">$${Math.min(...AppState.trades.filter(t=>t.pnl!=null).map(t=>t.pnl),0)}</span>`]].map(([l,v])=>`<div class="mini-item"><div class="mini-label">${l}</div><div class="mini-val">${v}</div></div>`).join('');
  };

  // ─── PORTFOLIO ───
  window.renderPortfolio = () => {
    const acct = getAcct();
    if (acct) document.getElementById('portAcctBadge').textContent = '— ' + acct.name;
    if (AppState.chartInst.alloc) AppState.chartInst.alloc.destroy();
    const s = computeStats(AppState.trades);
    document.getElementById('portStats').innerHTML=[{label:'P&L Total',val:fmt(s.pnl,true,'$'),cls:s.pnl>=0?'val-green':'val-red'},{label:'Capital',val:'$'+(acct?.capital||0).toLocaleString(),cls:'val-blue'},{label:'Ouverts',val:s.open,cls:'val-gold'},{label:'Total',val:s.total,cls:'val-white'}].map(c=>`<div class="stat-card"><div class="stat-card-label">${c.label}</div><div class="stat-card-value ${c.cls}">${c.val}</div></div>`).join('');
    const mkts=['Forex','Crypto','Actions','Matière première'],mColors=['#3b7fff','#8b5cf6','#f59e0b','#22c55e'];
    AppState.chartInst.alloc=new Chart(document.getElementById('allocChart').getContext('2d'),{type:'doughnut',data:{labels:mkts,datasets:[{data:mkts.map(m=>AppState.trades.filter(t=>t.market===m).length),backgroundColor:mColors.map(c=>c+'33'),borderColor:mColors,borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:'#9ca3b0',font:{size:12},padding:14,boxWidth:12}}}}});
    const open=AppState.trades.filter(t=>t.status==='Ouvert');
    const icons={Forex:'💱',Crypto:'₿',Actions:'📈','Matière première':'🏅'};
    document.getElementById('openPositions').innerHTML=open.length?open.map(t=>`<div class="asset-row"><div class="asset-icon" style="background:rgba(59,127,255,.12)">${icons[t.market]||'📊'}</div><div class="asset-info"><div class="asset-name">${t.instrument}</div><div class="asset-sub">${t.market} · ${t.direction} · ${t.lots} lots</div></div><div class="asset-right"><div class="asset-val" style="color:var(--blue)">@ ${t.entry}</div><div class="asset-pct">${t.date}</div></div></div>`).join(''):`<div style="color:var(--text-dim);font-size:12.5px;padding:16px 0">Aucune position ouverte</div>`;
    const mkPnl=mkts.map(m=>({mkt:m,pnl:AppState.trades.filter(t=>t.market===m&&t.pnl!=null).reduce((a,t)=>a+t.pnl,0),count:AppState.trades.filter(t=>t.market===m).length,col:mColors[mkts.indexOf(m)]}));
    const maxP=Math.max(...mkPnl.map(m=>Math.abs(m.pnl)),1);
    document.getElementById('mktBreakdown').innerHTML=mkPnl.map(m=>`<div style="margin-bottom:12px"><div style="display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:5px"><span style="color:var(--text-mid)">${m.mkt} <span style="color:var(--text-dim);font-size:11px">(${m.count})</span></span><span style="color:${m.pnl>=0?'var(--green)':'var(--red)'}">${m.pnl>=0?'+':''}$${m.pnl.toFixed(0)}</span></div><div style="height:4px;background:var(--surface2);border-radius:2px;overflow:hidden"><div style="height:100%;width:${Math.abs(m.pnl)/maxP*100}%;background:${m.col};border-radius:2px"></div></div></div>`).join('');
  };

  // ─── OBJECTIVES ───
  window.renderObjectives = () => {
    const acct = getAcct();
    if (acct) document.getElementById('objAcctBadge').textContent = '— ' + acct.name;
    const s = computeStats(AppState.trades);
    const colors={'P&L ($)':'var(--green)','Win Rate (%)':'var(--blue)','Nb Trades':'var(--gold)','Drawdown max (%)':'var(--red)'};
    const icons={'P&L ($)':'💰','Win Rate (%)':'🎯','Nb Trades':'📊','Drawdown max (%)':'🛡️'};
    let objs = AppState.objectives.map(o => {
      if(o.type==='Win Rate (%)')return{...o,current:+s.wr.toFixed(1)};
      if(o.type==='Nb Trades')return{...o,current:s.total};
      if(o.type==='Drawdown max (%)')return{...o,current:+s.maxDD.toFixed(1)};
      return o;
    });
    document.getElementById('objGrid').innerHTML=objs.map(o=>{const pct=Math.min(100,o.current/o.target*100);const col=colors[o.type]||'var(--blue)';const unit=o.type.includes('%')?'%':o.type.includes('$')?'$':'';return`<div class="obj-card"><button class="obj-del" onclick="delObj('${o.id}')">✕</button><div class="obj-header"><div><div class="obj-title">${o.title}</div><div class="obj-type">${o.type}${o.desc?' · '+o.desc:''}</div></div><div class="obj-icon">${icons[o.type]||'🎯'}</div></div><div class="obj-nums"><div class="obj-current" style="color:${col}">${o.current}${unit}</div><div class="obj-target">/ ${o.target}${unit}</div></div><div class="obj-progress"><div class="obj-fill" style="width:${pct}%;background:${col}"></div></div><div class="obj-footer"><span><i class="fa-regular fa-calendar" style="margin-right:4px"></i>${o.deadline||'—'}</span><span style="color:${col}">${pct.toFixed(0)}%</span></div></div>`;}).join('')||`<div style="grid-column:1/-1;text-align:center;color:var(--text-dim);padding:48px">Aucun objectif pour ce compte.</div>`;
  };

  // ─── ACCOUNTS PAGE ───
  window.renderAccountsPage = () => {
    document.getElementById('accountsGrid').innerHTML = AppState.accounts.map(a => {
      const trades = AppState.activeAccountId === a.id ? AppState.trades : [];
      const pnl = AppState.activeAccountId === a.id ? AppState.trades.filter(t=>t.pnl!=null).reduce((s,t)=>s+t.pnl,0) : 0;
      const wr = AppState.activeAccountId === a.id ? computeStats(AppState.trades).wr.toFixed(0) : '—';
      const isActive = a.id === AppState.activeAccountId;
      return `<div class="acct-card ${isActive?'active-account':''}" onclick="switchAccount('${a.id}');showPage('dashboard',document.querySelectorAll('.nav-tab')[0])">
        <div class="acct-card-actions" onclick="event.stopPropagation()">
          <button class="acct-icon-btn" onclick="openEditAcctModal('${a.id}')"><i class="fa-solid fa-pen"></i></button>
          <button class="acct-icon-btn danger" onclick="deleteAccount('${a.id}')"><i class="fa-solid fa-trash"></i></button>
        </div>
        <div class="acct-card-top">
          <div class="acct-card-dot" style="background:${a.color}"></div>
          <span class="acct-card-type">${a.type}</span>
        </div>
        <div class="acct-card-name">${a.name}</div>
        <div class="acct-card-broker">${a.broker||'Aucun broker'} · $${(a.capital||0).toLocaleString()}</div>
        <div class="acct-card-pnl" style="color:${pnl>=0?'var(--green)':'var(--red)'}">${isActive?(pnl>=0?'+':'')+'$'+pnl.toFixed(2):'—'}</div>
        <div class="acct-card-stats">
          <span>📊 ${isActive?AppState.trades.length:'?'} trades</span>
          <span>🎯 ${wr}% WR</span>
        </div>
        ${isActive?'<div class="acct-active-badge">● Actif</div>':''}
      </div>`;
    }).join('') + `<div class="acct-card" style="display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;cursor:pointer;border-style:dashed" onclick="openNewAcctModal()"><i class="fa-solid fa-plus" style="font-size:22px;color:var(--text-dim)"></i><span style="color:var(--text-dim);font-size:13px">Nouveau compte</span></div>`;
  };

  // ─── CALCULATOR ───
  window.calcPos = () => {
    const cap=+document.getElementById('cCapital').value||0,risk=+document.getElementById('cRisk').value||0,entry=+document.getElementById('cEntry').value||0,sl=+document.getElementById('cSL').value||0,tp=+document.getElementById('cTP').value||0;
    const rAmt=cap*risk/100,slD=Math.abs(entry-sl),tpD=Math.abs(tp-entry),rr=slD>0?(tpD/slD).toFixed(2):0,pos=slD>0?(rAmt/slD).toFixed(2):0,profit=slD>0?(rAmt*parseFloat(rr)).toFixed(0):0;
    document.getElementById('calcResults').innerHTML=[['Risque ($)',`<span style="color:var(--red)">$${rAmt.toFixed(0)}</span>`],['Taille Position',`<span style="color:var(--blue)">${pos}</span>`],['Ratio R:R',`<span style="color:${rr>=2?'var(--green)':'var(--gold)'}">1:${rr}</span>`],['Profit Potentiel',`<span style="color:var(--green)">+$${profit}</span>`],['SL (pips)',`<span style="color:var(--text-mid)">${(slD*10000).toFixed(0)}</span>`],['TP (pips)',`<span style="color:var(--text-mid)">${(tpD*10000).toFixed(0)}</span>`]].map(([l,v])=>`<div class="result-item"><div class="result-label">${l}</div><div class="result-value">${v}</div></div>`).join('');
  };

  window.renderRules = () => {
    document.getElementById('rulesContainer').innerHTML=[{e:'🛡️',t:'Risque max 2% par trade',ok:true},{e:'📐',t:'R:R minimum 1:2',ok:true},{e:'📖',t:'Journaliser chaque trade',ok:true},{e:'🧠',t:'Pas de trading revenge',ok:true},{e:'⏰',t:'Éviter les news majeures',ok:false},{e:'📊',t:'Analyser les pertes',ok:true}].map(r=>`<div class="rule-item"><span>${r.e}</span><span style="flex:1;font-size:12.5px;color:var(--text-mid)">${r.t}</span><span style="color:${r.ok?'var(--green)':'var(--red)'}">${r.ok?'✓':'✗'}</span></div>`).join('');
  };

  // ─── EXPORT ───
  window.exportData = () => {
    const acct=getAcct();
    const h=['ID','Instrument','Marché','Direction','Entrée','Sortie','SL','TP','Lots','P&L','Statut','Date','Setup','Notes'];
    const rows=AppState.trades.map(t=>[t.id,t.instrument,t.market,t.direction,t.entry,t.exit||'',t.sl||'',t.tp||'',t.lots,t.pnl||'',t.status,t.date,t.setup||'',t.notes||'']);
    const blob=new Blob([[h,...rows].map(r=>r.join(',')).join('\n')],{type:'text/csv'});
    const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`${acct?.name||'trades'}_${new Date().toISOString().split('T')[0]}.csv`;a.click();
  };

  // ══════════════════════════════════════════════
  //  NAVIGATION
  // ══════════════════════════════════════════════
  window.showPage = (id, el) => {
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
    document.getElementById('page-'+id).classList.add('active');
    if (el) el.classList.add('active');
    if (id==='analytics') setTimeout(renderAnalytics, 80);
    if (id==='portfolio') setTimeout(renderPortfolio, 80);
    if (id==='objectives') renderObjectives();
    if (id==='calculator') { calcPos(); renderRules(); }
    if (id==='journal') renderJournal();
    if (id==='accounts') renderAccountsPage();
  };

  // ══════════════════════════════════════════════
  //  MODAL HELPERS
  // ══════════════════════════════════════════════
  window.openModal = () => { document.getElementById('tradeModal').classList.add('active'); document.getElementById('tDate').value=new Date().toISOString().split('T')[0]; };
  window.closeModal = () => document.getElementById('tradeModal').classList.remove('active');
  window.openObjModal = () => { document.getElementById('objModal').classList.add('active'); const d=new Date();d.setMonth(d.getMonth()+1);document.getElementById('oDeadline').value=d.toISOString().split('T')[0]; };
  window.closeObjModal = () => document.getElementById('objModal').classList.remove('active');

  window.openNewAcctModal = () => {
    AppState.editingAcctId = null;
    document.getElementById('newAcctModalTitle').textContent = 'Nouveau Compte';
    ['acctName','acctBroker','acctCapital','acctGoal'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('acctType').value='Live';
    AppState.selectedColor = COLORS[0];
    renderColorPicker();
    document.getElementById('newAcctModal').classList.add('active');
  };

  window.openEditAcctModal = (id) => {
    closeDropdown();
    AppState.editingAcctId = id;
    const a = getAcct(id);
    document.getElementById('newAcctModalTitle').textContent = 'Modifier le compte';
    document.getElementById('acctName').value = a.name;
    document.getElementById('acctType').value = a.type;
    document.getElementById('acctBroker').value = a.broker||'';
    document.getElementById('acctCapital').value = a.capital||'';
    document.getElementById('acctGoal').value = a.goal||'';
    AppState.selectedColor = a.color;
    renderColorPicker();
    document.getElementById('newAcctModal').classList.add('active');
  };

  window.closeNewAcctModal = () => document.getElementById('newAcctModal').classList.remove('active');

  window.selectColor = (c) => { AppState.selectedColor = c; renderColorPicker(); };

  function renderColorPicker() {
    document.getElementById('colorPicker').innerHTML = COLORS.map(c =>
      `<div class="color-dot ${c===AppState.selectedColor?'selected':''}" style="background:${c}" onclick="selectColor('${c}')"></div>`
    ).join('');
  }

  // ─── DROPDOWN ───
  window.toggleDropdown = () => {
    const dd=document.getElementById('acctDropdown');
    const open=dd.style.display!=='none';
    if (open){closeDropdown();return;}
    renderDropdownList();
    dd.style.display='block';
    document.getElementById('acctBtn').classList.add('open');
    setTimeout(()=>document.addEventListener('click',outsideHandler),0);
  };

  function closeDropdown() {
    document.getElementById('acctDropdown').style.display='none';
    document.getElementById('acctBtn').classList.remove('open');
    document.removeEventListener('click',outsideHandler);
  }
  window.closeDropdown = closeDropdown;

  function outsideHandler(e) {
    if (!document.getElementById('acctSelector').contains(e.target)) closeDropdown();
  }

  // ─── LOADER ───
  function showLoader(msg='Chargement...') {
    document.getElementById('loaderMsg').textContent=msg;
    document.getElementById('appLoader').style.display='flex';
  }
  function hideLoader() { document.getElementById('appLoader').style.display='none'; }

  // ─── SCREENS ───
  function showLoginScreen() {
    document.getElementById('loginScreen').style.display='flex';
    document.getElementById('appRoot').style.display='none';
    document.getElementById('appLoader').style.display='none';
  }

  function showApp() {
    document.getElementById('loginScreen').style.display='none';
    document.getElementById('appRoot').style.display='flex';
    renderAll();
  }

  function setLoginLoading(v) {
    document.getElementById('loginBtn').disabled=v;
    document.getElementById('loginBtn').innerHTML = v
      ? '<div class="login-spinner"></div> Connexion...'
      : '<img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" style="width:18px"> Se connecter avec Google';
  }

  function showLoginError(msg) {
    const el=document.getElementById('loginError');
    el.textContent=msg; el.style.display='block';
    setTimeout(()=>el.style.display='none',4000);
  }

  // ─── TOAST ───
  let toastTimer;
  function showToast(msg,color=null) {
    const t=document.getElementById('toast');
    t.innerHTML=(color?`<span style="width:8px;height:8px;border-radius:50%;background:${color};display:inline-block"></span> `:'')+msg;
    t.classList.remove('hidden');
    clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>t.classList.add('hidden'),2800);
  }
  window.showToast = showToast;

  // Close modals on bg
  ['tradeModal','objModal','newAcctModal'].forEach(id=>{
    document.getElementById(id).addEventListener('click',e=>{if(e.target===e.currentTarget)document.getElementById(id).classList.remove('active');});
  });
</script>

<style>
:root{--bg:#0d0f14;--bg2:#111318;--surface:#181b22;--surface2:#1e2128;--surface3:#23262f;--border:#2a2d36;--border2:#33363f;--blue:#3b7fff;--blue-dim:rgba(59,127,255,.12);--green:#22c55e;--green-dim:rgba(34,197,94,.12);--red:#ef4444;--red-dim:rgba(239,68,68,.12);--gold:#f59e0b;--gold-dim:rgba(245,158,11,.12);--purple:#8b5cf6;--text:#f1f3f7;--text-mid:#9ca3b0;--text-dim:#4b5263;}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);font-size:13px;}

/* ── LOGIN ── */
#loginScreen{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:1000;flex-direction:column;gap:0;}
.login-card{background:var(--surface);border:1px solid var(--border2);border-radius:16px;padding:44px 48px;width:420px;max-width:95vw;text-align:center;}
.login-logo{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:28px;}
.login-logo-icon{color:var(--blue);font-size:24px;}
.login-logo-text{font-size:22px;font-weight:800;letter-spacing:-.5px;}
.login-logo-badge{font-size:10px;font-weight:700;background:var(--blue);color:#fff;padding:2px 7px;border-radius:3px;}
.login-title{font-size:18px;font-weight:700;margin-bottom:6px;}
.login-sub{font-size:13px;color:var(--text-dim);margin-bottom:32px;line-height:1.6;}
.login-btn{width:100%;padding:12px;border-radius:9px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-family:'Inter',sans-serif;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:all .15s;}
.login-btn:hover{background:var(--surface3);border-color:var(--blue);}
.login-btn:disabled{opacity:.6;cursor:not-allowed;}
.login-spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
.login-error{margin-top:12px;color:var(--red);font-size:12px;background:var(--red-dim);border:1px solid rgba(239,68,68,.3);border-radius:7px;padding:8px 12px;display:none;}
.login-features{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:28px;}
.login-feat{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;text-align:left;}
.login-feat-icon{font-size:16px;margin-bottom:4px;}
.login-feat-title{font-size:12px;font-weight:600;color:var(--text);}
.login-feat-sub{font-size:11px;color:var(--text-dim);margin-top:2px;}
.login-footer{margin-top:20px;font-size:11px;color:var(--text-dim);}

/* ── APP LOADER ── */
#appLoader{position:fixed;inset:0;background:var(--bg);display:none;align-items:center;justify-content:center;flex-direction:column;gap:14px;z-index:999;}
.loader-ring{width:40px;height:40px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:spin .8s linear infinite;}
#loaderMsg{font-size:13px;color:var(--text-dim);}

/* ── APP ROOT ── */
#appRoot{display:none;flex-direction:column;height:100%;}

/* ── TOPNAV ── */
.topnav{position:fixed;top:0;left:0;right:0;height:46px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 18px;z-index:200;gap:0;}
.nav-logo{display:flex;align-items:center;gap:7px;margin-right:24px;flex-shrink:0;text-decoration:none;}
.nav-logo-icon{color:var(--blue);font-size:14px;}
.nav-logo-text{font-size:13.5px;font-weight:700;color:var(--text);letter-spacing:-.2px;}
.nav-logo-badge{font-size:9px;font-weight:700;background:var(--blue);color:#fff;padding:1px 6px;border-radius:3px;letter-spacing:.5px;}
.nav-tabs{display:flex;align-items:center;gap:2px;flex:1;justify-content:center;}
.nav-tab{display:flex;align-items:center;gap:6px;padding:6px 13px;border-radius:6px;cursor:pointer;font-size:12.5px;font-weight:500;color:var(--text-mid);transition:all .15s;border:none;background:transparent;}
.nav-tab:hover{color:var(--text);background:var(--surface);}
.nav-tab.active{background:var(--blue);color:#fff;}
.nav-tab i{font-size:11px;}
.nav-right{display:flex;align-items:center;gap:8px;margin-left:24px;flex-shrink:0;}

/* ── USER PILL ── */
.user-pill{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:3px 12px 3px 4px;cursor:pointer;transition:all .15s;position:relative;}
.user-pill:hover{background:var(--surface2);}
#userAvatar{width:28px;height:28px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;overflow:hidden;}
#userDisplayName{font-size:12px;font-weight:500;color:var(--text-mid);}
.user-menu{position:absolute;top:calc(100% + 6px);right:0;background:var(--surface);border:1px solid var(--border2);border-radius:9px;padding:6px;min-width:160px;box-shadow:0 8px 24px rgba(0,0,0,.4);z-index:300;display:none;}
.user-pill:hover .user-menu{display:block;}
.user-menu-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:6px;cursor:pointer;font-size:12.5px;color:var(--text-mid);transition:all .15s;}
.user-menu-item:hover{background:var(--surface2);color:var(--text);}
.user-menu-item.danger:hover{background:var(--red-dim);color:var(--red);}

/* ── ACCOUNT SELECTOR ── */
.acct-selector{position:relative;}
.acct-btn{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:7px;padding:5px 11px;cursor:pointer;transition:all .15s;min-width:170px;}
.acct-btn:hover{border-color:var(--border2);background:var(--surface2);}
.acct-btn-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.acct-btn-name{font-size:12.5px;font-weight:600;color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.acct-btn-type{font-size:10px;color:var(--text-dim);}
.acct-btn-arrow{color:var(--text-dim);font-size:10px;transition:transform .15s;}
.acct-btn.open .acct-btn-arrow{transform:rotate(180deg);}
.acct-dropdown{position:absolute;top:calc(100% + 6px);right:0;width:280px;background:var(--surface);border:1px solid var(--border2);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.5);z-index:300;overflow:hidden;animation:dropIn .15s ease;}
@keyframes dropIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
.acct-drop-header{padding:12px 14px 8px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.acct-drop-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);}
.acct-drop-add{font-size:11.5px;color:var(--blue);cursor:pointer;background:none;border:none;font-family:inherit;display:flex;align-items:center;gap:4px;}
.acct-drop-add:hover{text-decoration:underline;}
.acct-list{max-height:240px;overflow-y:auto;padding:6px;}
.acct-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:7px;cursor:pointer;transition:all .15s;border:1px solid transparent;}
.acct-item:hover{background:var(--surface2);}
.acct-item.selected{background:var(--blue-dim);border-color:rgba(59,127,255,.25);}
.acct-item-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.acct-item-info{flex:1;min-width:0;}
.acct-item-name{font-size:13px;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.acct-item-meta{font-size:10.5px;color:var(--text-dim);margin-top:1px;}
.acct-item-pnl{font-family:'DM Mono',monospace;font-size:12px;font-weight:600;flex-shrink:0;}
.acct-item-actions{display:flex;gap:4px;flex-shrink:0;}
.acct-icon-btn{width:22px;height:22px;border-radius:4px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:10px;transition:all .15s;}
.acct-icon-btn:hover{background:var(--surface3);color:var(--text);}
.acct-icon-btn.danger:hover{background:var(--red-dim);border-color:rgba(239,68,68,.3);color:var(--red);}
.acct-drop-footer{padding:8px;border-top:1px solid var(--border);}
.acct-manage-btn{width:100%;text-align:center;padding:7px;border-radius:6px;font-size:12px;color:var(--text-dim);background:none;border:1px solid var(--border);cursor:pointer;font-family:inherit;transition:all .15s;}
.acct-manage-btn:hover{background:var(--surface2);color:var(--text);}

/* ── WRAPPER ── */
.wrapper{margin-top:46px;min-height:calc(100vh - 46px);overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border) transparent;}
.container{max-width:1160px;margin:0 auto;padding:26px 24px;}
.page{display:none;}.page.active{display:block;}
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;}
.page-title{font-size:21px;font-weight:700;color:var(--text);letter-spacing:-.4px;display:flex;align-items:center;gap:10px;}
.title-badge{font-size:11px;font-weight:500;color:var(--blue);background:var(--blue-dim);border:1px solid rgba(59,127,255,.25);padding:2px 9px;border-radius:20px;}
.page-subtitle{font-size:12px;color:var(--text-dim);margin-top:3px;}
.page-subtitle span{color:var(--text-mid);cursor:pointer;text-decoration:underline;}

/* ── BTN ── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:7px;border:none;font-family:'Inter',sans-serif;font-size:12.5px;font-weight:500;cursor:pointer;transition:all .15s;}
.btn-primary{background:var(--blue);color:#fff;}.btn-primary:hover{background:#2d6fe8;}
.btn-ghost{background:var(--surface2);color:var(--text-mid);border:1px solid var(--border);}.btn-ghost:hover{background:var(--surface3);color:var(--text);}
.btn-sm{padding:5px 10px;font-size:11.5px;}

/* ── STATS ── */
.stats-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-bottom:16px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:13px 15px;transition:border-color .2s;}.stat-card:hover{border-color:var(--border2);}
.stat-card-label{font-size:9.5px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;}
.stat-card-value{font-size:19px;font-weight:700;letter-spacing:-.5px;line-height:1;margin-bottom:4px;font-variant-numeric:tabular-nums;}
.stat-card-sub{font-size:10px;color:var(--text-dim);}
.val-green{color:var(--green);}.val-red{color:var(--red);}.val-blue{color:var(--blue);}.val-gold{color:var(--gold);}.val-white{color:var(--text);}

/* ── CARD ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px 20px;}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.card-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--text-mid);}
.card-action{font-size:11.5px;color:var(--blue);cursor:pointer;background:none;border:none;font-family:inherit;}.card-action:hover{text-decoration:underline;}
.empty-msg{text-align:center;color:var(--text-dim);font-size:12.5px;padding:32px 0;}

/* ── ACCT BANNER ── */
.acct-banner{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 20px;margin-bottom:16px;display:flex;align-items:center;gap:20px;}
.acct-banner-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.acct-banner-info{flex:1;}
.acct-banner-name{font-size:16px;font-weight:700;color:var(--text);}
.acct-banner-meta{font-size:11.5px;color:var(--text-dim);margin-top:2px;display:flex;gap:14px;}
.acct-banner-meta span{display:flex;align-items:center;gap:4px;}

/* ── CHARTS ── */
.charts-row{display:grid;grid-template-columns:1fr .55fr;gap:12px;margin-bottom:16px;}
.analytics-3col{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;}
.analytics-2col{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
.portfolio-2col{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}

/* ── TABLE ── */
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
th{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);}
td{padding:10px 12px;border-bottom:1px solid rgba(42,45,54,.5);color:var(--text-mid);font-size:12.5px;}
tr:last-child td{border-bottom:none;}tr:hover td{background:rgba(30,33,40,.5);}
.symbol{font-family:'DM Mono',monospace;font-weight:500;color:var(--text);font-size:13px;}
.mono{font-family:'DM Mono',monospace;font-size:12px;}
.tag{display:inline-block;font-size:10px;font-weight:600;padding:2px 7px;border-radius:4px;letter-spacing:.3px;}
.tag-buy{background:var(--green-dim);color:var(--green);}.tag-sell{background:var(--red-dim);color:var(--red);}
.tag-forex{background:var(--blue-dim);color:var(--blue);}.tag-crypto{background:rgba(139,92,246,.12);color:var(--purple);}
.tag-stock{background:var(--gold-dim);color:var(--gold);}.tag-commodity{background:rgba(245,158,11,.1);color:#d97706;}
.status{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:500;padding:2px 8px;border-radius:20px;}
.s-open{background:var(--blue-dim);color:var(--blue);}.s-win{background:var(--green-dim);color:var(--green);}.s-loss{background:var(--red-dim);color:var(--red);}
.pnl-p{color:var(--green);font-family:'DM Mono',monospace;font-weight:500;}.pnl-n{color:var(--red);font-family:'DM Mono',monospace;font-weight:500;}

/* ── FILTER ── */
.filter-bar{display:flex;gap:8px;align-items:center;margin-bottom:12px;}
.filter-bar select{background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:5px 10px;font-size:12px;outline:none;font-family:'Inter',sans-serif;-webkit-appearance:none;}

/* ── OBJ ── */
.obj-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.obj-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px 20px;position:relative;}
.obj-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;}
.obj-title{font-size:14px;font-weight:600;color:var(--text);}.obj-type{font-size:10.5px;color:var(--text-dim);margin-top:2px;}
.obj-icon{font-size:20px;}
.obj-nums{display:flex;align-items:baseline;gap:5px;margin-bottom:10px;}
.obj-current{font-size:26px;font-weight:700;letter-spacing:-.5px;}.obj-target{font-size:13px;color:var(--text-dim);}
.obj-progress{height:4px;background:var(--surface3);border-radius:2px;overflow:hidden;margin-bottom:8px;}
.obj-fill{height:100%;border-radius:2px;transition:width .8s ease;}
.obj-footer{display:flex;justify-content:space-between;font-size:11px;color:var(--text-dim);}
.obj-del{position:absolute;top:12px;right:12px;background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:13px;opacity:.5;}.obj-del:hover{opacity:1;color:var(--red);}

/* ── CALC ── */
.calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.result-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:16px;}
.result-item{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:11px;}
.result-label{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-dim);margin-bottom:3px;}
.result-value{font-size:17px;font-weight:700;letter-spacing:-.3px;}
.rule-item{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;margin-bottom:7px;}

/* ── ACCOUNTS ── */
.accounts-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.acct-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px 20px;transition:border-color .2s;cursor:pointer;position:relative;}
.acct-card:hover{border-color:var(--border2);}
.acct-card.active-account{border-color:rgba(59,127,255,.5);background:rgba(59,127,255,.04);}
.acct-card-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;}
.acct-card-dot{width:10px;height:10px;border-radius:50%;margin-top:2px;}
.acct-card-type{font-size:10px;color:var(--text-dim);background:var(--surface2);border:1px solid var(--border);padding:2px 8px;border-radius:4px;}
.acct-card-name{font-size:15px;font-weight:700;color:var(--text);margin-bottom:2px;}
.acct-card-broker{font-size:11.5px;color:var(--text-dim);}
.acct-card-pnl{font-family:'DM Mono',monospace;font-size:22px;font-weight:700;margin:10px 0 4px;}
.acct-card-stats{display:flex;gap:12px;font-size:11px;color:var(--text-dim);}
.acct-card-actions{position:absolute;top:14px;right:14px;display:flex;gap:4px;opacity:0;transition:opacity .15s;}
.acct-card:hover .acct-card-actions{opacity:1;}
.acct-active-badge{position:absolute;bottom:14px;right:14px;font-size:10px;font-weight:600;color:var(--blue);background:var(--blue-dim);border:1px solid rgba(59,127,255,.25);padding:2px 8px;border-radius:20px;}

/* ── FORM ── */
.form-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:11px;}
.form-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:11px;}
.form-group label{display:block;font-size:10.5px;font-weight:500;text-transform:uppercase;letter-spacing:.7px;color:var(--text-dim);margin-bottom:5px;}
.form-group input,.form-group select,.form-group textarea{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:8px 11px;color:var(--text);font-family:'Inter',sans-serif;font-size:13px;outline:none;transition:border-color .15s;-webkit-appearance:none;}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,127,255,.1);}
.form-group select option{background:var(--surface2);}

/* ── PORTFOLIO ── */
.asset-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(42,45,54,.5);}.asset-row:last-child{border:none;}
.asset-icon{width:32px;height:32px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.asset-info{flex:1;}.asset-name{font-size:13px;font-weight:600;color:var(--text);}.asset-sub{font-size:11px;color:var(--text-dim);margin-top:1px;}
.asset-right{text-align:right;}.asset-val{font-family:'DM Mono',monospace;font-weight:600;font-size:13px;}.asset-pct{font-size:11px;color:var(--text-dim);margin-top:1px;}

/* ── MINI ── */
.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.mini-item{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:11px 13px;}
.mini-label{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-dim);margin-bottom:3px;}
.mini-val{font-size:17px;font-weight:700;letter-spacing:-.3px;}

/* ── MODAL ── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:400;align-items:center;justify-content:center;backdrop-filter:blur(3px);}
.modal-bg.active{display:flex;}
.modal{background:var(--surface);border:1px solid var(--border2);border-radius:12px;padding:24px;width:580px;max-width:95vw;animation:modalIn .2s ease;}
.modal-sm{width:420px;}
@keyframes modalIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
.modal-title{font-size:16px;font-weight:700;color:var(--text);}
.modal-close{background:var(--surface2);border:1px solid var(--border);border-radius:6px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-dim);font-size:14px;transition:all .15s;}.modal-close:hover{background:var(--surface3);color:var(--text);}

/* ── COLOR PICKER ── */
.color-picker{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px;}
.color-dot{width:22px;height:22px;border-radius:50%;cursor:pointer;transition:transform .15s;border:2px solid transparent;}.color-dot:hover{transform:scale(1.2);}.color-dot.selected{border-color:#fff;}

/* ── TOAST ── */
.toast{position:fixed;bottom:24px;right:24px;background:var(--surface);border:1px solid var(--border2);border-radius:9px;padding:11px 18px;font-size:13px;color:var(--text);z-index:500;box-shadow:0 4px 20px rgba(0,0,0,.4);animation:toastIn .25s ease;display:flex;align-items:center;gap:9px;}
.toast.hidden{display:none;}
@keyframes toastIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

::-webkit-scrollbar{width:5px;height:5px;}::-webkit-scrollbar-track{background:transparent;}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}
</style>
</head>
<body>

<!-- ══ LOGIN SCREEN ══ -->
<div id="loginScreen" style="display:flex">
  <div class="login-card">
    <div class="login-logo">
      <i class="fa-solid fa-chart-line login-logo-icon"></i>
      <span class="login-logo-text">TradeTracker</span>
      <span class="login-logo-badge">PRO</span>
    </div>
    <div class="login-title">Bienvenue sur TradeTracker Pro</div>
    <div class="login-sub">Connectez-vous pour accéder à votre espace de trading personnel. Vos données sont strictement privées et sécurisées.</div>
    <button class="login-btn" id="loginBtn" onclick="signInWithGoogle()">
      <img src="./TradeTracker Pro_files/google.svg" style="width:18px">
      Se connecter avec Google
    </button>
    <div class="login-error" id="loginError"></div>
    <div class="login-features">
      <div class="login-feat"><div class="login-feat-icon">🔒</div><div class="login-feat-title">Données privées</div><div class="login-feat-sub">Isolées par compte</div></div>
      <div class="login-feat"><div class="login-feat-icon">☁️</div><div class="login-feat-title">Sync cloud</div><div class="login-feat-sub">Accès partout</div></div>
      <div class="login-feat"><div class="login-feat-icon">📊</div><div class="login-feat-title">Multi-comptes</div><div class="login-feat-sub">Gérez vos brokers</div></div>
      <div class="login-feat"><div class="login-feat-icon">⚡</div><div class="login-feat-title">Temps réel</div><div class="login-feat-sub">Firestore DB</div></div>
    </div>
    <div class="login-footer">🔐 Connexion sécurisée via Google OAuth 2.0 · Firebase Auth</div>
  </div>
</div>

<!-- ══ APP LOADER ══ -->
<div id="appLoader" style="display: none;">
  <div class="loader-ring"></div>
  <div id="loaderMsg">Chargement...</div>
</div>

<!-- ══ APP ROOT ══ -->
<div id="appRoot" style="display: none;">

  <!-- TOPNAV -->
  <nav class="topnav">
    <a class="nav-logo" href="file:///C:/Users/klopp/Downloads/index_4.html#"><i class="fa-solid fa-chart-line nav-logo-icon"></i><span class="nav-logo-text">TradeTracker</span><span class="nav-logo-badge">PRO</span></a>
    <div class="nav-tabs">
      <button class="nav-tab active" onclick="showPage(&#39;dashboard&#39;,this)"><i class="fa-solid fa-gauge-high"></i> Dashboard</button>
      <button class="nav-tab" onclick="showPage(&#39;journal&#39;,this)"><i class="fa-regular fa-book-open"></i> Journal</button>
      <button class="nav-tab" onclick="showPage(&#39;analytics&#39;,this)"><i class="fa-solid fa-chart-line"></i> Analytics</button>
      <button class="nav-tab" onclick="showPage(&#39;objectives&#39;,this)"><i class="fa-solid fa-bullseye"></i> Objectifs</button>
      <button class="nav-tab" onclick="showPage(&#39;calculator&#39;,this)"><i class="fa-solid fa-calculator"></i> Calculateur</button>
      <button class="nav-tab" onclick="showPage(&#39;portfolio&#39;,this)"><i class="fa-solid fa-briefcase"></i> Portefeuille</button>
      <button class="nav-tab" onclick="showPage(&#39;accounts&#39;,this)"><i class="fa-solid fa-layer-group"></i> Comptes</button>
    </div>
    <div class="nav-right">
      <!-- Account selector -->
      <div class="acct-selector" id="acctSelector">
        <div class="acct-btn" id="acctBtn" onclick="toggleDropdown()">
          <div class="acct-btn-dot" id="acctBtnDot"></div>
          <span class="acct-btn-name" id="acctBtnName">—</span>
          <span class="acct-btn-type" id="acctBtnType"></span>
          <i class="fa-solid fa-chevron-down acct-btn-arrow" id="acctArrow"></i>
        </div>
        <div class="acct-dropdown" id="acctDropdown" style="display:none">
          <div class="acct-drop-header">
            <span class="acct-drop-title">Mes Comptes</span>
            <button class="acct-drop-add" onclick="openNewAcctModal();closeDropdown()"><i class="fa-solid fa-plus"></i> Nouveau</button>
          </div>
          <div class="acct-list" id="acctDropList"></div>
          <div class="acct-drop-footer">
            <button class="acct-manage-btn" onclick="showPage(&#39;accounts&#39;,document.querySelectorAll(&#39;.nav-tab&#39;)[6]);closeDropdown()"><i class="fa-solid fa-gear"></i> Gérer les comptes</button>
          </div>
        </div>
      </div>
      <!-- User pill -->
      <div class="user-pill">
        <div id="userAvatar">?</div>
        <span id="userDisplayName">—</span>
        <i class="fa-solid fa-chevron-down" style="font-size:9px;color:var(--text-dim)"></i>
        <div class="user-menu">
          <div class="user-menu-item" onclick="showPage(&#39;accounts&#39;,document.querySelectorAll(&#39;.nav-tab&#39;)[6])"><i class="fa-solid fa-layer-group"></i> Mes comptes</div>
          <div class="user-menu-item danger" onclick="doSignOut()"><i class="fa-solid fa-right-from-bracket"></i> Déconnexion</div>
        </div>
      </div>
      <button class="btn btn-primary btn-sm" onclick="openModal()"><i class="fa-solid fa-plus"></i> Nouveau trade</button>
    </div>
  </nav>

  <!-- WRAPPER -->
  <div class="wrapper">

    <!-- DASHBOARD -->
    <div class="page active" id="page-dashboard">
      <div class="container">
        <div class="page-header">
          <div class="page-title-wrap"><div class="page-title">Dashboard <span class="title-badge" id="dashAcctBadge"></span></div><div class="page-subtitle" id="dashSub"></div></div>
          <button class="btn btn-ghost btn-sm" onclick="exportData()"><i class="fa-solid fa-download"></i> Export CSV</button>
        </div>
        <div class="acct-banner" id="acctBanner"></div>
        <div class="stats-grid" id="statsGrid"></div>
        <div class="charts-row">
          <div class="card"><div class="card-header"><span class="card-title">P&amp;L Cumulatif</span></div><div style="position:relative;height:200px"><canvas id="equityChart"></canvas><div class="empty-msg" id="equityEmpty">Ajoutez des trades pour voir le graphique</div></div></div>
          <div class="card"><div class="card-header"><span class="card-title">P&amp;L par Mois</span></div><div style="position:relative;height:200px"><canvas id="monthlyChartDash"></canvas><div class="empty-msg" id="monthlyEmpty">Aucune donnée</div></div></div>
        </div>
        <div class="card"><div class="card-header"><span class="card-title">Trades récents</span><button class="card-action" onclick="showPage(&#39;journal&#39;,document.querySelectorAll(&#39;.nav-tab&#39;)[1])">Voir tout →</button></div><div class="table-wrap"><table><thead><tr><th>Symbole</th><th>Dir.</th><th>Marché</th><th>Entrée</th><th>Sortie</th><th>P&amp;L</th><th>Statut</th><th>Date</th></tr></thead><tbody id="recentBody"></tbody></table></div></div>
      </div>
    </div>

    <!-- JOURNAL -->
    <div class="page" id="page-journal">
      <div class="container">
        <div class="page-header"><div class="page-title-wrap"><div class="page-title">Journal <span class="title-badge" id="journalAcctBadge"></span></div><div class="page-subtitle" id="journalSub"></div></div><button class="btn btn-primary btn-sm" onclick="openModal()"><i class="fa-solid fa-plus"></i> Nouveau trade</button></div>
        <div class="filter-bar">
          <select id="filterMarket" onchange="renderJournal()"><option value="">Tous les marchés</option><option>Forex</option><option>Crypto</option><option>Actions</option><option>Matière première</option></select>
          <select id="filterDir" onchange="renderJournal()"><option value="">Toutes directions</option><option>BUY</option><option>SELL</option></select>
          <select id="filterStatus" onchange="renderJournal()"><option value="">Tous statuts</option><option>Ouvert</option><option>Gagné</option><option>Perdu</option></select>
        </div>
        <div class="card"><div class="table-wrap"><table><thead><tr><th>#</th><th>Symbole</th><th>Marché</th><th>Dir.</th><th>Entrée</th><th>Sortie</th><th>SL</th><th>TP</th><th>Lots</th><th>P&amp;L</th><th>R:R</th><th>Statut</th><th>Setup</th><th>Date</th><th></th></tr></thead><tbody id="journalBody"></tbody></table></div></div>
      </div>
    </div>

    <!-- ANALYTICS -->
    <div class="page" id="page-analytics">
      <div class="container">
        <div class="page-header"><div class="page-title">Analytics <span class="title-badge" id="analyticsAcctBadge"></span></div></div>
        <div class="analytics-3col">
          <div class="card"><div class="card-header"><span class="card-title">P&amp;L Mensuel</span></div><div style="height:170px"><canvas id="monthlyChart"></canvas></div></div>
          <div class="card"><div class="card-header"><span class="card-title">Win / Loss</span></div><div style="height:170px"><canvas id="winLossChart"></canvas></div></div>
          <div class="card"><div class="card-header"><span class="card-title">P&amp;L par Marché</span></div><div style="height:170px"><canvas id="pnlMarketChart"></canvas></div></div>
        </div>
        <div class="analytics-2col">
          <div class="card"><div class="card-header"><span class="card-title">Performance par Jour</span></div><div style="height:170px"><canvas id="weeklyChart"></canvas></div></div>
          <div class="card"><div class="card-header"><span class="card-title">Indicateurs Clés</span></div><div class="mini-grid" id="keyStats"></div></div>
        </div>
      </div>
    </div>

    <!-- OBJECTIVES -->
    <div class="page" id="page-objectives">
      <div class="container">
        <div class="page-header"><div class="page-title">Objectifs <span class="title-badge" id="objAcctBadge"></span></div><button class="btn btn-primary btn-sm" onclick="openObjModal()"><i class="fa-solid fa-plus"></i> Nouvel objectif</button></div>
        <div class="obj-grid" id="objGrid"></div>
      </div>
    </div>

    <!-- CALCULATOR -->
    <div class="page" id="page-calculator">
      <div class="container">
        <div class="page-header"><div class="page-title">Calculateur de Position</div></div>
        <div class="calc-grid">
          <div class="card"><div class="card-header"><span class="card-title">Paramètres</span></div>
            <div class="form-grid-2">
              <div class="form-group"><label>Capital ($)</label><input type="number" id="cCapital" value="10000" oninput="calcPos()"></div>
              <div class="form-group"><label>Risque (%)</label><input type="number" id="cRisk" value="2" step="0.1" oninput="calcPos()"></div>
              <div class="form-group"><label>Prix Entrée</label><input type="number" id="cEntry" value="1.0850" step="0.0001" oninput="calcPos()"></div>
              <div class="form-group"><label>Stop Loss</label><input type="number" id="cSL" value="1.0800" step="0.0001" oninput="calcPos()"></div>
              <div class="form-group"><label>Take Profit</label><input type="number" id="cTP" value="1.0950" step="0.0001" oninput="calcPos()"></div>
              <div class="form-group"><label>Marché</label><select id="cMarket" onchange="calcPos()"><option>Forex</option><option>Crypto</option><option>Actions</option><option>Matière première</option></select></div>
            </div>
            <div class="result-grid" id="calcResults"></div>
          </div>
          <div class="card"><div class="card-header"><span class="card-title">Règles de Trading</span></div><div id="rulesContainer"></div></div>
        </div>
      </div>
    </div>

    <!-- PORTFOLIO -->
    <div class="page" id="page-portfolio">
      <div class="container">
        <div class="page-header"><div class="page-title">Portefeuille <span class="title-badge" id="portAcctBadge"></span></div></div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px" id="portStats"></div>
        <div class="portfolio-2col">
          <div class="card"><div class="card-header"><span class="card-title">Allocation par Marché</span></div><div style="height:220px"><canvas id="allocChart"></canvas></div></div>
          <div class="card"><div class="card-header"><span class="card-title">Positions Ouvertes</span></div><div id="openPositions"></div></div>
        </div>
        <div class="card"><div class="card-header"><span class="card-title">P&amp;L par Marché</span></div><div id="mktBreakdown"></div></div>
      </div>
    </div>

    <!-- ACCOUNTS -->
    <div class="page" id="page-accounts">
      <div class="container">
        <div class="page-header"><div class="page-title-wrap"><div class="page-title">Mes Comptes</div><div class="page-subtitle">Vos comptes de trading personnels</div></div><button class="btn btn-primary" onclick="openNewAcctModal()"><i class="fa-solid fa-plus"></i> Nouveau compte</button></div>
        <div class="accounts-grid" id="accountsGrid"></div>
      </div>
    </div>

  </div><!-- /wrapper -->
</div><!-- /appRoot -->

<!-- MODALS -->
<div class="modal-bg" id="tradeModal">
  <div class="modal">
    <div class="modal-header"><div class="modal-title">Nouveau Trade — <span id="tradeModalAcct" style="color:var(--blue)"></span></div><button class="modal-close" onclick="closeModal()">✕</button></div>
    <div class="form-grid-3">
      <div class="form-group"><label>Instrument *</label><input type="text" id="tInstr" placeholder="EUR/USD, BTC..."></div>
      <div class="form-group"><label>Marché *</label><select id="tMkt"><option>Forex</option><option>Crypto</option><option>Actions</option><option>Matière première</option></select></div>
      <div class="form-group"><label>Direction</label><select id="tDir"><option>BUY</option><option>SELL</option></select></div>
      <div class="form-group"><label>Entrée *</label><input type="number" id="tEntry" placeholder="0.0000" step="0.0001"></div>
      <div class="form-group"><label>Sortie</label><input type="number" id="tExit" step="0.0001"></div>
      <div class="form-group"><label>Stop Loss</label><input type="number" id="tSL" step="0.0001"></div>
      <div class="form-group"><label>Take Profit</label><input type="number" id="tTP" step="0.0001"></div>
      <div class="form-group"><label>Lots / Qté</label><input type="number" id="tLots" value="0.10" step="0.01"></div>
      <div class="form-group"><label>P&amp;L ($)</label><input type="number" id="tPnl" placeholder="+/-"></div>
      <div class="form-group"><label>Date</label><input type="date" id="tDate"></div>
      <div class="form-group"><label>Statut</label><select id="tStat"><option>Ouvert</option><option>Gagné</option><option>Perdu</option></select></div>
      <div class="form-group"><label>Setup</label><input type="text" id="tSetup"></div>
    </div>
    <div class="form-group" style="margin-bottom:16px"><label>Notes</label><textarea id="tNotes" rows="2"></textarea></div>
    <div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn btn-ghost" onclick="closeModal()">Annuler</button><button class="btn btn-primary" onclick="saveTrade()"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button></div>
  </div>
</div>

<div class="modal-bg" id="objModal">
  <div class="modal modal-sm">
    <div class="modal-header"><div class="modal-title">Nouvel Objectif</div><button class="modal-close" onclick="closeObjModal()">✕</button></div>
    <div class="form-grid-2">
      <div class="form-group" style="grid-column:1/-1"><label>Titre *</label><input type="text" id="oTitle"></div>
      <div class="form-group"><label>Type</label><select id="oType"><option>P&amp;L ($)</option><option>Win Rate (%)</option><option>Nb Trades</option><option>Drawdown max (%)</option></select></div>
      <div class="form-group"><label>Cible</label><input type="number" id="oTarget"></div>
      <div class="form-group"><label>Actuel</label><input type="number" id="oCurrent"></div>
      <div class="form-group"><label>Deadline</label><input type="date" id="oDeadline"></div>
      <div class="form-group" style="grid-column:1/-1"><label>Description</label><input type="text" id="oDesc"></div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px"><button class="btn btn-ghost" onclick="closeObjModal()">Annuler</button><button class="btn btn-primary" onclick="saveObj()"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button></div>
  </div>
</div>

<div class="modal-bg" id="newAcctModal">
  <div class="modal modal-sm">
    <div class="modal-header"><div class="modal-title" id="newAcctModalTitle">Nouveau Compte</div><button class="modal-close" onclick="closeNewAcctModal()">✕</button></div>
    <div class="form-grid-2" style="margin-bottom:12px">
      <div class="form-group" style="grid-column:1/-1"><label>Nom *</label><input type="text" id="acctName" placeholder="Compte Challenge..."></div>
      <div class="form-group"><label>Type</label><select id="acctType"><option>Live</option><option>Demo</option><option>Challenge</option><option>Funded</option><option>Perso</option></select></div>
      <div class="form-group"><label>Broker</label><input type="text" id="acctBroker" placeholder="FTMO, Binance..."></div>
      <div class="form-group"><label>Capital ($)</label><input type="number" id="acctCapital"></div>
      <div class="form-group"><label>Objectif ($)</label><input type="number" id="acctGoal"></div>
    </div>
    <div class="form-group" style="margin-bottom:16px"><label>Couleur</label><div class="color-picker" id="colorPicker"></div></div>
    <div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn btn-ghost" onclick="closeNewAcctModal()">Annuler</button><button class="btn btn-primary" onclick="saveAccount()"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button></div>
  </div>
</div>

<div class="toast hidden" id="toast"></div>



</body></html>
